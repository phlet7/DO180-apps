{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No install needed'",
  "buildCommand": "mkdir -p public/todo && cp -a todoapp/html5/src/. public/ && cp -a todoapp/html5/src/. public/todo/",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/todo/(.*)",
      "destination": "/api/todo-api?p=$1"
    },
    {
      "source": "/todo/api/(.*)",
      "destination": "/api/todo-api?p=$1"
    }
  ]
}
